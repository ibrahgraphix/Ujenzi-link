{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://ujenzilink-backend.vercel.app/sitemap.xml"
    },
    {
      "source": "/listings/:id",
      "destination": "https://ujenzilink-backend.vercel.app/html-meta/listings/:id"
    },
    {
      "source": "/providers/:id",
      "destination": "https://ujenzilink-backend.vercel.app/html-meta/providers/:id"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}