# Frontend Environment Variables
# Copy this file to .env and fill in your values.

# Backend API base URL — must match the port your backend runs on.
VITE_API_BASE_URL=http://localhost:3001

# ImageKit URL endpoint (public) — used for thumbnail transformation URLs in the browser.
# Must match IMAGEKIT_URL_ENDPOINT in the backend .env (same value).
VITE_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Optional: Supabase anon/publishable key (for direct Supabase client calls, if used in future).
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
