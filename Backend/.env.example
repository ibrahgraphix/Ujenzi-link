# Server Configuration
PORT=3001
NODE_ENV=development

# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_service_role_key_here
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_anon_key_here

# App Domain Configuration
INTERNAL_EMAIL_DOMAIN=ujenzilink.internal

# ImageKit (required for image uploads)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Frontend URL (CORS)
# Production domains (https://ujenzi-link.com and https://www.ujenzi-link.com) are
# explicitly listed in src/index.ts and do NOT need to be set here.
# Set this to your Vercel preview/staging deployment URL so that staging branches
# are also allowed through CORS. Leave unset for local-only development.
# Example: FRONTEND_URL=https://ujenzi-link-git-feature-branch.vercel.app
FRONTEND_URL=
